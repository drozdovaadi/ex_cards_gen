        "upper_lats",
        "teres_major",
        "rhomboids",
        "lower_trapezius",
        "spinal_erectors",
        "rear_deltoid",
        "lateral_deltoid",
        "front_deltoid",
        "upper_trapezius",
        "upper_chest",
        "mid_chest",
        "lower_chest",
        "triceps_long_head",
        "triceps_lateral_head",
        "triceps_medial_head",
        "biceps_brachii",
        "brachialis",
