        "synergist",
        "stabilizer",
        "dynamic_stabilizer",
        "antagonist_control",
        "postural_support",
        "fixator",
        "minor_contributor",
        "unclear"
      ]
    },
    "muscle_length_state": {
      "enum": [
        "lengthening",
        "shortening",
        "near_isometric",
        "lengthened",
        "mid_range",
        "shortened",
        "mixed",
        "unclear"
      ]
